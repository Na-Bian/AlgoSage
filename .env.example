# 运行缺省使用真实 API（需要下方密钥）；mock 用于离线流程演示和测试。
APP_MODE=api
EXAM_MODE=true

# Example: SiliconFlow's hosted open-weight Qwen3-8B.
# You must create your own API key. Never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
# 简单概念/明确简短请求的正文上限；详细请求仍使用 LLM_MAX_OUTPUT_TOKENS
EG_CONCISE_MAX_OUTPUT_TOKENS=768
# 规则通过后并行安全与知识复核；不足3个剩余额度时顺序执行
EG_PARALLEL_REVIEWS=true
# OpenAI-compatible hosted providers vary: max_tokens or max_completion_tokens
LLM_TOKEN_PARAMETER=max_tokens
# 服务商专属参数（经 extra_body 透传）；SiliconFlow Qwen3.5 关闭思考模式可大幅降低时延
#EG_LLM_EXTRA_BODY={"enable_thinking": false}

# 教师演示开关：true 时 Chainlit 界面才允许切换考试/练习模式（默认 false，
# 学生常规运行无法绕过服务端 EXAM_MODE 限制）。仅用于本地演示与教学展示。
EG_ALLOW_POLICY_SWITCH=false

# P1 意图分类器模式：
#   regex  = 冻结的正则基线（默认，离线可用，供消融实验对照）
#   hybrid = 规则+LLM 混合（需 APP_MODE=api；LLM 超时/解析失败自动回退正则）
EG_CLASSIFIER_MODE=regex

# P2 输出审核层：
#   basic   = 第一阶段冻结基线（供消融对照）
#   rules   = 规则预筛（默认，离线可用：代码块/入口点/状态转移式/证明收尾/
#             完整解答自称/编号算法步骤）
#   layered = 规则预筛 + 独立 LLM Judge（需 APP_MODE=api；Judge 不可用返回 unknown 并安全回退）
EG_OUTPUT_GUARD=rules

# P2 教师侧策略文件（可选）。缺省用内嵌默认映射；文件非法时启动直接失败。
# 示例见 config/exam_policy.json（支持按题只收紧的帮助等级覆盖与重生成预算）。
#EG_POLICY_FILE=config/exam_policy.json

# P4 Harness 费用估算（可选；每百万 token 价格，人民币元）。
# 未配置时 Harness 明确输出"未估算"，不伪造数字。
#EG_PRICE_PER_MTOK_IN=2.0
#EG_PRICE_PER_MTOK_OUT=8.0

# 前端审计面板展示密度：brief=一行摘要（默认，学生视图）；full=完整表格（教师/研究）
#EG_UI_DETAIL=brief

# Audit repairs: trusted exam binding and retained safety budgets
EG_EXAM_ID=demo
# EG_QUESTION_ID=q-dp-easy
EG_STATE_FILE=.examguard/state.sqlite3
EG_MAX_CALLS_PER_TURN=9
EG_TURN_TIMEOUT_SECONDS=180
EG_CLASSIFIER_MAX_OUTPUT_TOKENS=256
EG_JUDGE_MAX_OUTPUT_TOKENS=768
EG_QUALITY_MAX_OUTPUT_TOKENS=512
EG_MIN_CLASSIFIER_CONFIDENCE=0.7

# Multi-conversation workspace (local browser identity; not student authentication)
# Relative file paths resolve against CHAINLIT_APP_ROOT (default: project directory).
# A separate HttpOnly workspace cookie preserves identity for a year and renews
# within the last 30 days of normal use; API login tokens remain short-lived.
EG_CHAT_FILE=.examguard/chats.sqlite3
EG_AUTH_SECRET_FILE=.examguard/auth.secret
# Additional providers reference server environment variable names, never inline keys.
# Default optional file: .examguard/providers.json. See providers.example.json.
# EG_PROVIDERS_FILE=providers.example.json
# DEEPSEEK_API_KEY=

# HUST student authentication is always enabled. Use SMTP outside local development.
# EG_AUTH_DB_FILE=.examguard/auth.sqlite3
# EG_STUDENT_EMAIL_DOMAIN=hust.edu.cn
# EG_STUDENT_ID_PATTERN=^U202[0-9]1[0-9]{4}$
# EG_AUTH_CODE_TTL_SECONDS=600
# EG_AUTH_CODE_MAX_ATTEMPTS=5
# EG_AUTH_CODE_RESEND_SECONDS=60
# EG_AUTH_HOURLY_ACCOUNT_LIMIT=5
# EG_AUTH_HOURLY_IP_LIMIT=10

# Email delivery for HUST auth. outbox is development-only and stores readable codes.
# EG_EMAIL_SENDER=outbox
# EG_EMAIL_OUTBOX_DIR=.examguard/dev-outbox
# EG_SMTP_HOST=
# EG_SMTP_PORT=465
# EG_SMTP_USERNAME=
# EG_SMTP_PASSWORD=
# EG_EMAIL_FROM="ExamGuard <no-reply@example.com>"
# EG_SMTP_USE_TLS=true
