# 默认使用真实 API（需要下方密钥）；mock 仅为单元测试夹具，不再作为运行默认。
APP_MODE=api
EXAM_MODE=true

# Example: SiliconFlow's hosted open-weight Qwen3-8B.
# You must create your own API key. Never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
# OpenAI-compatible hosted providers vary: max_tokens or max_completion_tokens
LLM_TOKEN_PARAMETER=max_tokens
# 服务商专属参数（经 extra_body 透传）；SiliconFlow Qwen3.5 关闭思考模式可大幅降低时延
#EG_LLM_EXTRA_BODY={"enable_thinking": false}

# 教师演示开关：true 时 Chainlit 界面才允许切换考试/练习模式（默认 false，
# 学生常规运行无法绕过服务端 EXAM_MODE 限制）。仅用于本地演示与教学展示。
EG_ALLOW_POLICY_SWITCH=false

# P1 意图分类器模式：
#   regex  = 冻结的正则基线（默认，离线可用，供消融实验对照）
#   hybrid = 规则+LLM 混合（需 APP_MODE=api；LLM 超时/解析失败自动回退正则）
EG_CLASSIFIER_MODE=regex

# P2 输出审核层：
#   basic   = 第一阶段冻结基线（供消融对照）
#   rules   = 规则预筛（默认，离线可用：代码块/入口点/状态转移式/证明收尾/
#             完整解答自称/编号算法步骤）
#   layered = 规则预筛 + 独立 LLM Judge（需 APP_MODE=api；Judge 不可用自动降级规则层）
EG_OUTPUT_GUARD=rules

# P2 教师侧策略文件（可选）。缺省用内嵌默认映射；文件非法时启动直接失败。
# 示例见 config/exam_policy.json（支持按题只收紧的帮助等级覆盖与重生成预算）。
#EG_POLICY_FILE=config/exam_policy.json

# P4 Harness 费用估算（可选；每百万 token 价格，人民币元）。
# 未配置时 Harness 明确输出"未估算"，不伪造数字。
#EG_PRICE_PER_MTOK_IN=2.0
#EG_PRICE_PER_MTOK_OUT=8.0

# 前端审计面板展示密度：brief=一行摘要（默认，学生视图）；full=完整表格（教师/研究）
#EG_UI_DETAIL=brief
