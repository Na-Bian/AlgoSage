# 运行缺省使用真实 API（需要下方密钥）；mock 用于离线流程演示和测试。
APP_MODE=api
EXAM_MODE=true

# Example: SiliconFlow's hosted open-weight Qwen3-8B.
# You must create your own API key. Never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=32768
# 学生在设置面板可调的「最大输出长度」以本值为上限；简单概念/明确简短
# 请求的正文上限仍由 SAGE_CONCISE_MAX_OUTPUT_TOKENS 决定
SAGE_CONCISE_MAX_OUTPUT_TOKENS=768
# 规则通过后并行安全与知识复核；不足3个剩余额度时顺序执行
SAGE_PARALLEL_REVIEWS=true
# OpenAI-compatible hosted providers vary: max_tokens or max_completion_tokens
LLM_TOKEN_PARAMETER=max_tokens
# 服务商专属参数（经 extra_body 透传）；SiliconFlow Qwen3.5 关闭思考模式可大幅降低时延
#SAGE_LLM_EXTRA_BODY={"enable_thinking": false}

# 内置辅助模型：与学生会话模型解耦的辅助任务各有专属配置；
# 未配置时依次回退 CLASSIFIER_* → 主模型配置（TITLE_* 回退主模型）。
# 生成标题用小模型即可（缺省 Qwen3.5-4B 档）：
#TITLE_MODEL=Qwen/Qwen3.5-4B
#TITLE_BASE_URL=
#TITLE_API_KEY=
# 意图分类 LLM 层 + 解法要素抽取（hybrid 分类模式下生效；正则保留为地板）：
#CLASSIFIER_MODEL=Qwen/Qwen3.5-9B
#CLASSIFIER_BASE_URL=
#CLASSIFIER_API_KEY=
# 语义审核 Judge + 质量审查（layered 审核模式下生效；服务端策略执行，
# 判定尺度不应随学生自选的模型漂移）：
#JUDGE_MODEL=Qwen/Qwen3.8-27B
#JUDGE_BASE_URL=
#JUDGE_API_KEY=

# P1 意图分类器模式：
#   regex  = 冻结的正则基线（默认，离线可用，供消融实验对照）
#   hybrid = 规则+LLM 混合（需 APP_MODE=api；LLM 超时/解析失败自动回退正则）
SAGE_CLASSIFIER_MODE=regex

# P2 输出审核层：
#   basic   = 第一阶段冻结基线（供消融对照）
#   rules   = 规则预筛（默认，离线可用：代码块/入口点/状态转移式/证明收尾/
#             完整解答自称/编号算法步骤）
#   layered = 规则预筛 + 独立 LLM Judge（需 APP_MODE=api；Judge 不可用返回 unknown 并安全回退）
SAGE_OUTPUT_GUARD=rules

# 学习保护策略文件（可选）。缺省用内嵌默认映射；文件非法时启动直接失败。
# 示例见 config/exam_policy.json（支持按题只收紧的帮助等级覆盖与重生成预算）。
#SAGE_POLICY_FILE=config/exam_policy.json

# P4 Harness 费用估算（可选；每百万 token 价格，人民币元）。
# 未配置时 Harness 明确输出"未估算"，不伪造数字。
#SAGE_PRICE_PER_MTOK_IN=2.0
#SAGE_PRICE_PER_MTOK_OUT=8.0

# 前端审计面板展示密度：brief=一行摘要（默认，学生视图）；full=完整表格（研究/调试）
#SAGE_UI_DETAIL=brief

# Personal assistant learning-protection state
SAGE_EXAM_ID=demo
# SAGE_QUESTION_ID=q-dp-easy
SAGE_STATE_FILE=.algosage/state.sqlite3
SAGE_MAX_CALLS_PER_TURN=9
SAGE_MAX_INPUT_CHARS=20000
SAGE_DAILY_REQUESTS_PER_STUDENT=100
SAGE_GLOBAL_DAILY_REQUESTS=1000
SAGE_TURN_TIMEOUT_SECONDS=180
SAGE_CLASSIFIER_MAX_OUTPUT_TOKENS=256
SAGE_JUDGE_MAX_OUTPUT_TOKENS=768
SAGE_QUALITY_MAX_OUTPUT_TOKENS=512
SAGE_MIN_CLASSIFIER_CONFIDENCE=0.7

# Multi-conversation workspace (local browser identity; not student authentication)
# Relative file paths resolve against CHAINLIT_APP_ROOT (default: project directory).
# A separate HttpOnly workspace cookie preserves identity for a year and renews
# within the last 30 days of normal use; API login tokens remain short-lived.
SAGE_CHAT_FILE=.algosage/chats.sqlite3
SAGE_AUTH_SECRET_FILE=.algosage/auth.secret
# Additional providers reference server environment variable names, never inline keys.
# DEEPSEEK_API_KEY=

# HUST student authentication is always enabled. Use SMTP outside local development.
SAGE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CHAINLIT_COOKIE_SAMESITE=strict
SAGE_SECURE_COOKIES=false
# SAGE_AUTH_DB_FILE=.algosage/auth.sqlite3
# SAGE_STUDENT_EMAIL_DOMAIN=hust.edu.cn
# SAGE_STUDENT_ID_PATTERN=^U202[0-9]1[0-9]{4}$
# SAGE_AUTH_CODE_TTL_SECONDS=600
# SAGE_AUTH_CODE_MAX_ATTEMPTS=5
# SAGE_AUTH_CODE_RESEND_SECONDS=60
# SAGE_AUTH_HOURLY_ACCOUNT_LIMIT=5
# SAGE_AUTH_HOURLY_IP_LIMIT=10

# Email delivery for HUST auth. outbox is development-only and stores readable codes.
# SAGE_EMAIL_SENDER=outbox
# SAGE_EMAIL_OUTBOX_DIR=.algosage/dev-outbox
# SAGE_SMTP_HOST=
# SAGE_SMTP_PORT=465
# SAGE_SMTP_USERNAME=
# SAGE_SMTP_PASSWORD=
# SAGE_SMTP_AUTH=true
# SAGE_EMAIL_FROM="AlgoSage <no-reply@example.edu>"
# SAGE_SMTP_USE_TLS=true
#
# QQ Mail example:
# SAGE_SMTP_HOST=smtp.qq.com
# SAGE_SMTP_PORT=465
# SAGE_SMTP_USERNAME=your-account@qq.com
# SAGE_SMTP_PASSWORD=QQ-mail-authorization-code
# SAGE_EMAIL_FROM=AlgoSage <your-account@qq.com>
